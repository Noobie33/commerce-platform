{
  "name": "commerce-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "build": "npm run build:api && npm run build:admin && npm run build:storefront",
    "check": "tsc -p tsconfig.json --noEmit && npm run check --workspace=@commerce/admin && npm run check:storefront",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "db:check-admin": "npm run build && node --env-file=.env.setup dist/src/scripts/database-check.js",
    "test:database": "npm run build && node --env-file=.env.test --test --test-concurrency=1 dist/test/database.integration.js dist/test/identity.integration.js dist/test/profile-photo.integration.js dist/test/catalog.integration.js dist/test/media.integration.js dist/test/inventory.integration.js dist/test/purchasing.integration.js dist/test/receipts.integration.js dist/test/invoices.integration.js dist/test/payments.integration.js dist/test/reports.integration.js dist/test/customers.integration.js dist/test/sales.integration.js dist/test/reservations.integration.js dist/test/retail.integration.js dist/test/content.integration.js dist/test/live-updates.integration.js dist/test/merch.integration.js dist/test/presentation.integration.js dist/test/publication.integration.js dist/test/staff-access.integration.js dist/test/staff-onboarding.integration.js dist/test/video-intake.integration.js dist/test/gallery.integration.js",
    "db:provision-local": "node --env-file=.env.setup src/scripts/provision-local.mjs",
    "db:verify-local": "node src/scripts/verify-local-databases.mjs",
    "start:local": "node src/scripts/start-local.mjs",
    "db:migrate": "npm run build && node --env-file=.env dist/src/scripts/migrate.js",
    "staff:bootstrap-owner": "npm run build && node --env-file=.env dist/src/scripts/bootstrap-owner.js",
    "format": "prettier --write \"src/**/*.{ts,mjs}\" \"test/**/*.ts\" \"apps/**/*.{ts,tsx,css,html,json}\" \"docs/**/*.md\" \"*.json\" \"*.md\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,mjs}\" \"test/**/*.ts\" \"apps/**/*.{ts,tsx,css,html,json}\" \"docs/**/*.md\" \"*.json\" \"*.md\" \".github/**/*.{yml,yaml}\"",
    "build:api": "node src/scripts/build.mjs",
    "build:admin": "npm run build --workspace=@commerce/admin",
    "secrets:check": "node src/scripts/check-secrets.mjs",
    "media:verify-local": "node --env-file=.env dist/src/scripts/verify-media-storage.js",
    "inventory:verify-local": "node --env-file=.env dist/src/scripts/verify-inventory.js",
    "purchasing:verify-local": "node --env-file=.env dist/src/scripts/verify-purchasing.js",
    "invoices:verify-local": "node --env-file=.env dist/src/scripts/verify-invoices.js",
    "payments:verify-local": "node --env-file=.env dist/src/scripts/verify-payments.js",
    "customers:verify-local": "node --env-file=.env dist/src/scripts/verify-customers.js",
    "sales:verify-local": "node --env-file=.env dist/src/scripts/verify-sales.js",
    "reservations:verify-local": "node --env-file=.env dist/src/scripts/verify-reservations.js",
    "content:verify-local": "node --env-file=.env dist/src/scripts/verify-content.js",
    "merchandising:verify-local": "node --env-file=.env dist/src/scripts/verify-merchandising.js",
    "presentation:verify-local": "node --env-file=.env dist/src/scripts/verify-presentation.js",
    "publication:verify-local": "node --env-file=.env dist/src/scripts/verify-publication.js",
    "access:verify-local": "node --env-file=.env dist/src/scripts/verify-staff-access.js",
    "onboarding:verify-local": "node --env-file=.env dist/src/scripts/verify-staff-onboarding.js",
    "video:verify-tools": "node --env-file=.env.video dist/src/scripts/verify-video-tools.js",
    "video:prepare-local": "node --env-file=.env.video dist/src/scripts/prepare-video.js",
    "test:video": "node --env-file=.env.video --test --test-concurrency=1 dist/test/video-processing.integration.js",
    "video:worker-local": "node --env-file=.env.video-worker dist/src/scripts/video-worker.js",
    "video:reconcile-local": "node --env-file=.env.video-worker dist/src/scripts/video-worker.js --reconcile",
    "video:verify-local": "node --env-file=.env dist/src/scripts/verify-video-intake.js",
    "gallery:verify-local": "node --env-file=.env dist/src/scripts/verify-gallery.js",
    "gallery:verify-publication": "node --env-file=.env dist/src/scripts/verify-gallery-release.js",
    "build:storefront": "npm run build --workspace=@commerce/storefront",
    "check:storefront": "npm run check --workspace=@commerce/storefront",
    "store:local": "node src/scripts/start-storefront.mjs",
    "start:demo": "node src/scripts/start-demo.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "workspaces": [
    "apps/admin",
    "apps/storefront"
  ]
}
