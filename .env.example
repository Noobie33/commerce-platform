# Public template only. Setup already generated .env/.env.test; do not overwrite them.
HOST=127.0.0.1
PORT=4000
NODE_ENV=development
STAFF_ORIGIN=http://127.0.0.1:4000
# Filled by local provisioning, not by copying a default password:
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Optional absolute media directory. Local development defaults to ignored .local-media/.
# Production must configure a protected persistent absolute directory.
# MEDIA_STORAGE_DIR=

# Optional bounded media-policy overrides; defaults shown:
# MEDIA_MAX_PHOTOS=24
# MEDIA_MAX_UPLOAD_MB=20
# MEDIA_MAX_PIXELS=64000000
# MEDIA_UPLOAD_CONCURRENCY=1
